# ============================================================================
# Google AdSense configuration (RideSharing frontend)
#
# The Publisher ID and Ad Slot below are the exact values from the AdSense
# dashboard and are the defaults used by the app. The script is loaded once in
# index.html.
#
#   VITE_ENABLE_ADS=true  → master switch for ALL advertisements.
#                           Set to false to hide every ad without touching the
#                           rest of the website.
#
# You may leave the VITE_ADSENSE_* values unset — the app falls back to the
# real unit below. (They exist only for future override, e.g. swapping account.)
# ============================================================================
VITE_ENABLE_ADS=true
VITE_ADSENSE_CLIENT_ID=ca-pub-9837776506614641
VITE_ADSENSE_HOME_SLOT=9364054937
VITE_ADSENSE_RIDE_LIST_SLOT=9364054937
VITE_ADSENSE_RIDE_DETAILS_SLOT=9364054937
VITE_ADSENSE_SIDEBAR_SLOT=9364054937
VITE_ADSENSE_MOBILE_BOTTOM_SLOT=9364054937
