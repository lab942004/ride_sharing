# ============================================================================
# Google AdSense configuration (RideSharing frontend)
# ============================================================================
VITE_ENABLE_ADS=true
VITE_ADSENSE_CLIENT_ID="your_adsense_ID_key"
VITE_ADSENSE_HOME_SLOT="your_adsense_ID_key"
VITE_ADSENSE_RIDE_LIST_SLOT="your_adsense_ID_key"
VITE_ADSENSE_RIDE_DETAILS_SLOT="your_adsense_ID_key"
VITE_ADSENSE_SIDEBAR_SLOT="your_adsense_ID_key"
VITE_ADSENSE_MOBILE_BOTTOM_SLOT="your_adsense_ID_key"

# ============================================================================
# SEO — canonical / sitemap / Open Graph base URL
# ============================================================================
# The absolute URL of your PRODUCTION site (e.g. "https://rideshares.example.com").
# Vite injects this into index.html (canonical + og:url + JSON-LD) and into the
# robots.txt / sitemap.xml generated at build time. Search engines use it as the
# source of truth for what URLs to index, so it MUST match your real domain.
VITE_APP_URL=http://localhost:5173
