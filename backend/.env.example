# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/ride_share_db"

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ─── JWT (user tokens) ─────────────────────────────────────────────────────
JWT_SECRET="your_super_secret_jwt_key_min_32_chars_change_this"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_min_32_chars_change_this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── JWT (admin tokens — MUST be different values from the user secrets above,
#     so a compromise of one tier's secret does not also compromise the other) ──
JWT_ADMIN_SECRET="a_completely_different_super_secret_key_min_32_chars"
JWT_ADMIN_REFRESH_SECRET="a_completely_different_refresh_secret_key_min_32_chars"

# ─── Cookies (httpOnly refresh-token cookies) ─────────────────────────────────
# Leave unset for localhost dev (cookies default to the request host).
# Set to your apex domain in production, e.g. ".yourdomain.com", so the
# cookie is sent correctly if frontend/admin-panel/backend are on subdomains.
COOKIE_DOMAIN=

# Defaults to "none" in production (required for the common case of
# frontend/backend on different hosts, e.g. Vercel + Render — otherwise the
# browser silently drops the refresh cookie on reload and users get logged
# out every time). Only set this to "lax" if frontend and backend are
# genuinely same-site (identical origin, or subdomains with COOKIE_DOMAIN set
# above) and you want the stricter policy.
COOKIE_SAME_SITE=

# ─── Resend Email API (primary) ───────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="RideShare NIT KKR <noreply@nitkkr.ac.in>"

# ─── Nodemailer SMTP (fallback) ───────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_gmail@gmail.com"
SMTP_PASS="your_gmail_app_password"

# ─── Web Push Notifications (VAPID keys) ─────────────────────────────────────
# Generate your own keys with: `npx web-push generate-vapid-keys`
# The public key is exposed to the frontend (in a .env var for the frontend
# build); the private key stays server-side only.
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:you@example.com"

# ─── Geocoding (Mappls/MapmyIndia autosuggest) ────────────────────────────────
# Used for the location autosuggest dropdown in the ride creation form.
# MAPPLS_API_KEY is the Mappls REST API key (see backend/src/utils/mappls.utils.js).
#
# Get a key: https://about.mappls.com/api/ → sign up → Console → create a
# project → copy the REST API key. Full docs:
# https://developer.mappls.com/documentation/sdk/rest-apis/
#
# NOTE: on a standard sign-up key, forward search results only resolve to a
# map pin if "Location Coordinates" is enabled on the key (it's a premium
# subtemplate of the Place Details API). If search stops returning
# coordinates, email apisupport@mappls.com or enable that subtemplate for
# your key in the Console.
MAPPLS_API_KEY="your_mappls_api_key"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ─── Allowed email domains are now managed via the admin panel (Super Admin
#     → Domains), not an env var. Seed one via `npm run seed` for local dev,
#     or add it in the admin panel after first deploy. Nothing here needed.

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must include BOTH the student
# frontend and the admin panel origins — cookies (used for refresh tokens)
# are strictly origin-scoped, so a missing origin here means that app's
# login/refresh silently breaks.
FRONTEND_URL="http://localhost:5173,http://localhost:5174"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=5

# ─── Local dev seed script (prisma/seed.js) — optional overrides ─────────────
# Refuses to run at all if NODE_ENV=production. All accounts get fresh random
# passwords printed once to the console — nothing is ever hardcoded.
# SEED_SUPER_ADMIN_EMAIL=superadmin@example.local
# SEED_ADMIN_DOMAIN=yourcollege.ac.in
# SEED_SAMPLE_DATA=true
